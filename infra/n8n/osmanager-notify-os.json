{
  "name": "Delvor - Notificação OS",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notify-os-tecnico",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [-800, 0],
      "id": "a1b2c3d4-1111-2222-3333-444455556666",
      "name": "Webhook",
      "webhookId": "notify-os-tecnico-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Normaliza payload e prepara variáveis para os nós seguintes.\nconst body = $input.first().json.body ?? $input.first().json ?? {};\n\nconst digits = (s) => String(s ?? '').replace(/\\D+/g, '');\n\nlet number = digits(body.phone ?? body.number ?? '');\nif (number.length === 10 || number.length === 11) number = '55' + number;\n\nconst text = String(body.text ?? body.message ?? '').trim();\nconst company_id = body.company_id ?? null;\nconst os_id = body.os_id ?? null;\nconst sent_by_user_id = body.sent_by_user_id ?? body.user_id ?? null;\nconst instance_name_input = body.instance_name ?? body.instance_id ?? null;\n\nreturn [{\n  json: {\n    number,\n    text,\n    company_id,\n    os_id,\n    sent_by_user_id,\n    instance_name_input,\n    needs_lookup: !instance_name_input && !!company_id,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-600, 0],
      "id": "a1b2c3d4-2222-3333-4444-555566667777",
      "name": "Prepara payload"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.needs_lookup }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true },
              "id": "if-lookup-1"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-400, 0],
      "id": "a1b2c3d4-3333-4444-5555-666677778888",
      "name": "Precisa lookup?"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "wpp_instances",
        "returnAll": false,
        "limit": 1,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "company_id", "condition": "eq", "keyValue": "={{ $json.company_id }}" },
            { "keyName": "is_default", "condition": "eq", "keyValue": "true" }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [-200, -120],
      "id": "a1b2c3d4-4444-5555-6666-777788889999",
      "name": "Busca instância default",
      "credentials": {
        "supabaseApi": {
          "id": "wjHkMOfQnBoTeESX",
          "name": "SupabaseCRMServices"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Une os dados: pega instance_name do input ou da lookup\nconst prepared = $('Prepara payload').first().json;\nlet instance_name = prepared.instance_name_input;\n\n// Se veio da lookup\nif (!instance_name) {\n  const lookup = $input.first()?.json;\n  if (lookup?.instance_name) {\n    instance_name = lookup.instance_name;\n  }\n}\n\nif (!instance_name) {\n  throw new Error('Nenhuma instância padrão encontrada para a empresa.');\n}\n\nreturn [{\n  json: {\n    ...prepared,\n    instance_name,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [0, 0],
      "id": "a1b2c3d4-5555-6666-7777-888899990000",
      "name": "Resolve instância"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_URL }}/message/sendText/{{ $json.instance_name }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.EVOLUTION_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.number, text: $json.text }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 0],
      "id": "a1b2c3d4-6666-7777-8888-999900001111",
      "name": "Evolution sendText",
      "retryOnFail": true,
      "maxTries": 2
    },
    {
      "parameters": {
        "operation": "create",
        "tableId": "wpp_conversations",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "company_id",      "fieldValue": "={{ $('Resolve instância').item.json.company_id }}" },
            { "fieldId": "instance_id",     "fieldValue": "={{ $('Resolve instância').item.json.instance_name }}" },
            { "fieldId": "remote_jid",      "fieldValue": "={{ $('Resolve instância').item.json.number }}" },
            { "fieldId": "message",         "fieldValue": "={{ $('Resolve instância').item.json.text }}" },
            { "fieldId": "from_me",         "fieldValue": "=true" },
            { "fieldId": "message_type",    "fieldValue": "conversation" },
            { "fieldId": "sent_by_user_id", "fieldValue": "={{ $('Resolve instância').item.json.sent_by_user_id }}" },
            { "fieldId": "message_id",      "fieldValue": "={{ $json?.key?.id }}" },
            { "fieldId": "raw_payload",     "fieldValue": "={{ JSON.stringify({ source: 'notify-os', os_id: $('Resolve instância').item.json.os_id, evo_response: $json }) }}" }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [400, 0],
      "id": "a1b2c3d4-7777-8888-9999-000011112222",
      "name": "Grava em wpp_conversations",
      "credentials": {
        "supabaseApi": {
          "id": "wjHkMOfQnBoTeESX",
          "name": "SupabaseCRMServices"
        }
      },
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"ok\": true, \"sent_to\": \"{{ $('Resolve instância').item.json.number }}\", \"instance\": \"{{ $('Resolve instância').item.json.instance_name }}\", \"message_id\": \"{{ $('Evolution sendText').item.json?.key?.id }}\" }",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [600, 0],
      "id": "a1b2c3d4-8888-9999-0000-111122223333",
      "name": "Responder OK"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Prepara payload", "type": "main", "index": 0 }]]
    },
    "Prepara payload": {
      "main": [[{ "node": "Precisa lookup?", "type": "main", "index": 0 }]]
    },
    "Precisa lookup?": {
      "main": [
        [{ "node": "Busca instância default", "type": "main", "index": 0 }],
        [{ "node": "Resolve instância", "type": "main", "index": 0 }]
      ]
    },
    "Busca instância default": {
      "main": [[{ "node": "Resolve instância", "type": "main", "index": 0 }]]
    },
    "Resolve instância": {
      "main": [[{ "node": "Evolution sendText", "type": "main", "index": 0 }]]
    },
    "Evolution sendText": {
      "main": [[{ "node": "Grava em wpp_conversations", "type": "main", "index": 0 }]]
    },
    "Grava em wpp_conversations": {
      "main": [[{ "node": "Responder OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
