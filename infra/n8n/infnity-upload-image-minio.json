      },
      "id": "c0a80101-0005-4001-8001-000000000005",
      "name": "MinIO PUT",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [432, 0]
    },
    {
      "parameters": {
        "jsCode": "// Monta a URL publica do arquivo\nconst PUBLIC_BASE = 'https://files.zapcompany.com.br/services.infnity';\nconst meta = $('Validar & Preparar').first().json;\n\nreturn [{\n  json: {\n    success: true,\n    url: `${PUBLIC_BASE}/${meta.key}`,\n    key: meta.key,\n    size: meta.size,\n    sizeKB: meta.sizeKB,\n    mime: meta.mime\n  }\n}];"
      },
