    {
      "parameters": {
        "jsCode": "// Aceita $json.body (webhook v2) ou $json (parsed direto)\nconst raw = $input.first().json;\nconst body = (raw.body && typeof raw.body === 'object') ? raw.body : raw;\n\nconst { filename, mime, data } = body;\n\nif (!data || !mime) {\n  throw new Error(`Campos obrigatorios faltando. Recebido: ${JSON.stringify(Object.keys(body || {}))}`);\n}\n\nconst allowedMimes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp', 'image/gif', 'image/svg+xml', 'application/pdf'];\nif (!allowedMimes.includes(mime.toLowerCase())) {\n  throw new Error(`Tipo nao permitido: ${mime}. Use JPEG, PNG, WebP, GIF, SVG ou PDF.`);\n}\n\nconst buffer = Buffer.from(data, 'base64');\nconst sizeKB = buffer.length / 1024;\nif (sizeKB > 10000) {\n  throw new Error(`Arquivo muito grande: ${sizeKB.toFixed(0)} KB (max 10 MB)`);\n}\n\nconst m = mime.toLowerCase();\nconst ext = m.includes('png') ? 'png'\n          : m.includes('webp') ? 'webp'\n          : m.includes('gif') ? 'gif'\n          : m.includes('svg') ? 'svg'\n          : m.includes('pdf') ? 'pdf'\n          : 'jpg';\nconst safeName = (filename || 'file').replace(/[^a-zA-Z0-9_-]/g, '').slice(0, 30) || 'file';\nconst key = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}-${safeName}.${ext}`;\n\nreturn [{\n  json: { key, mime, size: buffer.length, sizeKB: Math.round(sizeKB) },\n  binary: { file: { data, mimeType: mime, fileName: key, fileExtension: ext } }\n}];"
      },
      "id": "c0a80101-0004-4001-8001-000000000004",
      "name": "Validar & Preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 0]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "=http://typebot-minio:9000/services.infnity/{{ $json.key }}",
        "sendHeaders": true,
        "headerParameters": {
