# =====================================================================
# OSManager — Variáveis de ambiente
# Copie este arquivo para `.env` e preencha com seus dados.
# =====================================================================

# Supabase (obrigatório)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SEU_ANON_KEY

# WhatsApp Evolution (opcional — só se for usar o canal "Lite")
# A URL e o token costumam ficar configurados no painel da Evolution.
# Aqui ficam apenas placeholders para integrações server-side futuras.
# VITE_EVOLUTION_BASE_URL=
# VITE_EVOLUTION_API_KEY=

# WhatsApp Cloud / YCloud (opcional — só se for usar o canal oficial)
# VITE_YCLOUD_BASE_URL=
